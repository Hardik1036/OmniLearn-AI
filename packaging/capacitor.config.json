{
  "appId": "ai.omnilearn.app",
  "appName": "OmniLearn AI",
  "webDir": "../frontend",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*.workers.dev",
      "127.0.0.1",
      "localhost"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#F8FAFC",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FFFFFF"
    }
  }
}
