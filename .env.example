# ============================================================================
# OmniLearn AI — Environment Configuration Template (.env.example)
# Copy to `.env` and fill in your Admin credentials and AI API keys.
# ============================================================================

# --- 1. Single-Admin Login Credentials ---
OMNILEARN_ADMIN_USERNAME=admin
OMNILEARN_ADMIN_PASSWORD=omnilearn-admin-change-me

# --- 2. Multi-API Provider Keys ---
GEMINI_API_KEY=
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_API_KEYS=

GROQ_API_KEY=
GROQ_API_KEYS=

OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=

# --- 3. Google OAuth Sign-In (Gmail Login for Normal Users) ---
# Create an OAuth 2.0 Client ID (Web Application) in Google Cloud Console:
# Authorized redirect URI: http://127.0.0.1:8765/api/auth/google/callback (local)
#                       or https://<your-worker-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- 4. Online Runtime Policy & Optional Cloudflare AI Relay ---
OMNILEARN_REQUIRE_INTERNET=1
# Set OMNILEARN_CLOUD_URL to your deployed Worker URL (e.g. https://omnilearn.workers.dev)
# so downloaded System App users with no local API keys can use Worker default AI keys safely.
OMNILEARN_CLOUD_URL=
OMNILEARN_CLOUD_TOKEN=
